; Engine configuration file.
; This Godot project is a minimal RPG Deck boundary spike.
; It uses a minimal main scene that runs ProjectLoader.cs.

config_version=5

[application]

config/name="RPG Deck Godot Spike"
config/features=PackedStringArray("4.2", "C#")
run/main_scene="res://scenes/ProjectLoaderScene.tscn"
